#:culture{:id "ner.dish.tuwo", :name "Tuwo", :country "NER", :kind :dish, :summary "Thick porridge-like swallow food (e.g. tuwon masara) eaten primarily by the Hausa and Fulani; also eaten in Niger, Mali, Cameroon and other West African countries.", :url "https://en.wikipedia.org/wiki/Tuwo", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ner.dish.dambou", :name "Dambou", :country "NER", :kind :dish, :summary "Dish of shredded leafy greens native to the Zarma and Songhai peoples of southwestern Niger, traditionally eaten at festive occasions such as weddings.", :url "https://en.wikipedia.org/wiki/Dambou", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ner.dish.kilishi", :name "Kilishi", :country "NER", :kind :dish, :summary "Spiced, sun-dried meat (a form of jerky) originating in Hausaland, spanning southern Niger and northern Nigeria; some accounts credit its origin to the Hausa people of Niger.", :url "https://en.wikipedia.org/wiki/Kilishi", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ner.beverage.fura-da-nono", :name "Fura da nono", :country "NER", :kind :beverage, :summary "Drink of fermented milk (nono) mixed with balls of ground millet dough (fura), popular among the Zarma-Songhai, Fulani and Hausa peoples of the Sahel and also eaten in Niger.", :url "https://en.wikipedia.org/wiki/Fura_(food)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://fr.wikipedia.org/wiki/Oignon_violet_de_Galmi", :id "ner.product.violet-de-galmi", :kind :product, :name-local "Oignon violet de Galmi", :country "NER", :retrieved-at "2026-07-17", :summary "Purple-skinned onion variety cultivated in the Galmi region of Niger, selected as a local ecotype by the IRAT research institute in 1975 and prized across West Africa for its pungent flavor.", :name "Violet de Galmi", :url-provenance :wikipedia-fr}
#:culture{:url "https://en.wikipedia.org/wiki/Agadez_Cross", :id "ner.craft.agadez-cross", :kind :craft, :name-local "Croix d'Agadez", :country "NER", :retrieved-at "2026-07-17", :summary "Silver pendant made by the lost-wax casting process, produced especially by the Tuareg people of Niger, in particular the Kel Aïr and Kel Geress tribes.", :name "Agadez Cross", :url-provenance :wikipedia-en}
#:culture{:url "https://en.wikipedia.org/wiki/Gerewol", :id "ner.festival.gerewol", :kind :festival, :name-local "Guérewol", :country "NER", :retrieved-at "2026-07-17", :summary "Annual courtship ritual competition among the Wodaabe Fula people of Niger, held at the end of the rainy season around the Cure Salée gathering at In-Gall.", :name "Gerewol", :url-provenance :wikipedia-en}
#:culture{:id "ner.festival.cure-salee", :name "Cure Salée", :country "NER", :kind :festival, :summary "Yearly late-September gathering (\"Salt Cure\") of Tuareg and Wodaabe peoples in the northern Niger town of In-Gall, marking the end of the rainy season with herds brought to graze at the salt flats.", :url "https://en.wikipedia.org/wiki/Cure_Sal%C3%A9e", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ner.heritage.air-tenere-reserve", :name "Aïr and Ténéré National Nature Reserve", :country "NER", :kind :heritage, :summary "Niger's largest protected area, covering the Aïr Mountains and the Ténéré desert; designated a UNESCO World Heritage Site in 1991 and home to threatened species such as the addax and dorcas gazelle.", :url "https://en.wikipedia.org/wiki/A%C3%AFr_and_T%C3%A9n%C3%A9r%C3%A9_National_Nature_Reserve", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ner.heritage.agadez", :name "Historic Centre of Agadez", :country "NER", :kind :heritage, :summary "Historic centre of the Saharan trading city of Agadez, capital of the former Sultanate of Agadez, including the Agadez Grand Mosque (originally 1515, rebuilt 1844); inscribed as a UNESCO World Heritage Site in 2013.", :url "https://en.wikipedia.org/wiki/Agadez", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
